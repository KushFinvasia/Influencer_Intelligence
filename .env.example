# Database (Choose SQLite for local development or PostgreSQL for production)
# SQLite (Local):
DATABASE_URL=sqlite+aiosqlite:///./creator_intel.db
# PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/creator_intel

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Apify (Instagram)
APIFY_API_TOKEN=your_apify_token_here

# Groq (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Fallback LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Queue
QUEUE_WORKERS=5

# Discovery
DISCOVERY_MAX_DEPTH=3
ENRICHMENT_CACHE_DAYS=7

# Review
REVIEW_CONFIDENCE_THRESHOLD=0.7

# App
APP_ENV=development
LOG_LEVEL=INFO
